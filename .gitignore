# Dependencies.
/vendor/
/node_modules/

# Build output and release artefacts (dist/ is built by the release workflow).
/dist/
*.zip
*.zip.sha256

# Tooling caches.
.phpcs-cache

# Local environment and secrets (.env.local holds DEV_HOST / DEV_PORT for the Vite dev server).
.env
.env.*
!.env.example
auth.json

# Logs.
*.log
npm-debug.log*

# Editors and OS. (.vscode/settings.json is shared on purpose.)
.idea/
*.swp
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.DS_Store
Thumbs.db
desktop.ini
